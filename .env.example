# ============================================================================
# MADINA LUXURY CAR TRAVELS — environment configuration
# Copy this file to .env.local for local development, and add the same keys
# in your Vercel Project → Settings → Environment Variables for production.
# See README.md for the full setup walkthrough.
# ============================================================================

# ---- Database (required) ---------------------------------------------------
# Any Postgres connection string works: Vercel Postgres, Neon, Supabase, or
# your own. Must include ?sslmode=require for most hosted providers.
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# ---- Admin authentication (required) ---------------------------------------
# The single business-owner login. There is no public sign-up — this is the
# only account, on purpose.
#
# DEMO CREDENTIALS — for trying the app locally only. Replace both values
# before deploying to production. Email: admin@madinaluxury.demo
# Password: MadinaDemo@2026
ADMIN_EMAIL="admin@madinaluxury.demo"
ADMIN_PASSWORD_HASH="$2b$10$GzG/h3S8d5maIsi.YNicJ.Q3Kmi1vg8PJIwRdoUEA/wXcVsL2F1pG"

# To generate a hash for your own password, run:
#   npm run hash-password -- "YourNewPassword"
# and paste the output above.

# Random secret used to sign admin session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="replace-this-with-a-long-random-string"

# ---- Image uploads (required for the admin "upload image" feature) --------
# Create a Blob store in your Vercel project (Storage tab) and copy the
# token it gives you. Not required to browse the public site.
BLOB_READ_WRITE_TOKEN=""

# ---- Public site config (required) -----------------------------------------
# The deployed URL of this website. Used to build the QR code and SEO tags.
# Update this after your first deployment (e.g. https://madinaluxury.vercel.app)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Business WhatsApp number in international format, digits only, no + or 00.
# Example for an Indian mobile number: country code 91 + 10-digit number.
NEXT_PUBLIC_WHATSAPP_NUMBER="910000000000"

# Business phone number as customers should dial it.
NEXT_PUBLIC_PHONE_NUMBER="+91 00000 00000"

# ---- Optional public contact details ---------------------------------------
# Leave blank to show "coming soon" / placeholder copy instead of made-up info.
NEXT_PUBLIC_BUSINESS_EMAIL=""
NEXT_PUBLIC_BUSINESS_ADDRESS=""
NEXT_PUBLIC_BUSINESS_HOURS="Mon – Sun, 6:00 AM – 11:00 PM"
NEXT_PUBLIC_GOOGLE_MAPS_URL=""
