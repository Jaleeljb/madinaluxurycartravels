# Password required to log into /admin
# If not set, the app falls back to the default: madina2026
ADMIN_PASSWORD=choose-a-strong-password

# Database (Upstash Redis) — required for admin add/edit/delete to work
# once deployed. See README.md "Database setup" for the two-minute setup.
# Without these, the site still works locally (it falls back to writing
# data/cars.json on disk), but on Vercel — or any host with a read-only
# filesystem — saving changes will fail until these are set.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
